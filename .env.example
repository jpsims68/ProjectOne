# ProjectOne — environment variable NAMES only. No values, ever.
#
# Copy this file to `.env` and fill in local values. `.env` is git-ignored and
# MUST NEVER be committed. `secret_protection` is a global non-waivable invariant.
#
# Config declares NAMES; values arrive at runtime. The same code reads a local
# Windows-auth connection here and a managed cloud credential later, without change.

# ---- Environment ------------------------------------------------------------
PROJECTONE_ENV=local

# ---- Database ---------------------------------------------------------------
# LOCAL: Windows Integrated Authentication. Trusted_Connection=yes means your
# Windows login IS the credential — there is no password to store or leak.
#
# TrustServerCertificate=yes is acceptable ONLY for a local instance with a
# self-signed certificate. It MUST be no in any deployed environment.
PROJECTONE_DB_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=localhost\MSSQLSERVERLOCAL;Database=projectone_dev;Trusted_Connection=yes;Encrypt=yes;TrustServerCertificate=yes;

# Parsed separately where tooling needs discrete values (sqlcmd, migrations).
PROJECTONE_DB_SERVER=localhost\MSSQLSERVERLOCAL
PROJECTONE_DB_NAME=projectone_dev
PROJECTONE_DB_TRUSTED_CONNECTION=yes

# ---- API --------------------------------------------------------------------
PROJECTONE_API_HOST=127.0.0.1
PROJECTONE_API_PORT=8000
PROJECTONE_LOG_LEVEL=INFO

# ---- Future cloud values ----------------------------------------------------
# Left blank deliberately. When OQ-13 resolves, these are populated from the
# platform's secret store and injected at runtime — never written to a file.
# PROJECTONE_DB_USER=
# PROJECTONE_DB_PASSWORD=
# PROJECTONE_KEY_VAULT_URI=
