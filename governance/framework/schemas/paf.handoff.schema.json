{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paf.handoff.schema.json",
  "title": "PAF Handoff Record",
  "description": "Transfer of work between roles, sessions, workbenches, or platforms. A handoff that omits required fields is invalid and the receiver must refuse it rather than infer.",
  "type": "object",
  "required": ["handoffId", "workItemId", "fromActor", "toRole", "lifecycleStateAtHandoff", "sourceBundleVersion", "workProductRefs", "acceptanceCriteria", "timestamp"],
  "properties": {
    "handoffId": { "$ref": "paf.common.schema.json#/$defs/identifier" },
    "workItemId": { "$ref": "paf.common.schema.json#/$defs/identifier" },
    "fromActor": { "$ref": "paf.common.schema.json#/$defs/actorRef" },
    "toRole": { "$ref": "paf.common.schema.json#/$defs/identifier" },
    "lifecycleStateAtHandoff": { "$ref": "paf.common.schema.json#/$defs/identifier" },
    "sourceBundleVersion": { "type": "string" },
    "workProductRefs": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "acceptanceCriteria": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "evidenceRefs": { "type": "array", "items": { "$ref": "paf.common.schema.json#/$defs/evidenceRef" } },
    "openQuestions": { "type": "array", "items": { "type": "string" } },
    "excludedContext": {
      "type": "boolean",
      "description": "True asserts the originator's private reasoning was deliberately withheld. Required true when this handoff feeds an independent review under SEPARATE_INVOCATION_CLEAN_CONTEXT."
    },
    "timestamp": { "$ref": "paf.common.schema.json#/$defs/timestamp" }
  },
  "additionalProperties": false
}
