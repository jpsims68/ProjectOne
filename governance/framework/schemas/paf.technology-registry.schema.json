{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "paf.technology-registry.schema.json",
  "title": "PAF Technology & Dependency Registry Contract (Step 22)",
  "description": "Constrains tool, dependency, and technology selection so an agent cannot choose unapproved options by convenience. Carries no project-specific stack.",
  "type": "object",
  "required": ["header", "approvalRule", "categories", "approvedEntries"],
  "properties": {
    "header": { "$ref": "paf.common.schema.json#/$defs/artifactHeader" },
    "approvalRule": {
      "const": "An agent may use only entries listed ACTIVE in this registry. An unlisted technology, tool, or dependency is DENIED by default (CR-5), regardless of convenience, familiarity, or apparent suitability. Adding an entry is a governed change."
    },
    "categories": {
      "type": "array", "minItems": 1,
      "items": { "enum": ["LANGUAGE_RUNTIME", "FRAMEWORK", "LIBRARY", "DATABASE", "BUILD_TOOL", "CI_TOOL", "IDE_EXTENSION", "INFRASTRUCTURE", "TESTING_TOOL", "SECURITY_TOOL"] }
    },
    "approvedEntries": {
      "type": "array",
      "description": "Populated at Profile binding.",
      "items": {
        "type": "object",
        "required": ["name", "category", "status", "approvedVersionRange"],
        "properties": {
          "name": { "type": "string" },
          "category": { "type": "string" },
          "status": { "enum": ["ACTIVE", "DEPRECATED", "PROHIBITED"] },
          "approvedVersionRange": { "type": "string" },
          "approvedBy": { "type": "string" },
          "supersededDecisionRef": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "changeHistory": { "type": "array", "items": { "type": "object", "additionalProperties": true } }
  },
  "additionalProperties": false
}
